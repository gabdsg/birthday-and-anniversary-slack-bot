# --- Required -----------------------------------------------------------------
# The process exits at boot naming any of these that are missing.

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/birthday_anniversary_bot

# Slack app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack app → Basic Information → App Credentials
SLACK_SIGNING_SECRET=your-signing-secret

# Slack app → Basic Information → App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-your-app-token

# Channel that receives birthday and anniversary messages. Invite the bot to it.
SLACK_CHANNEL_ID=C1234567890

# --- Optional -----------------------------------------------------------------

# Channel for the Thursday watercooler question. Unset disables that job.
SLACK_WATERCOOLER_CHANNEL_ID=C0987654321

# IANA timezone driving BOTH cron schedules and what counts as "today".
# The server's own TZ is deliberately not used. Default: America/New_York
BOT_TIMEZONE=America/New_York

# Port for the health-check server (only there to satisfy Heroku-style port binding).
# PORT=3000
